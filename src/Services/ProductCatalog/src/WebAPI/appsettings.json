{
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "MicroMartProductCatalog",
    "ProductsCollectionName": "products",
    "CategoriesCollectionName": "categories",
    "OutboxCollectionName": "outbox_messages",
    "MaxConnectionPoolSize": 100,
    "ServerSelectionTimeoutMs": 5000,
    "ConnectTimeoutMs": 3000
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "micromart-catalog:",
    "DefaultExpirySeconds": 300,
    "ConnectRetry": 3,
    "ConnectTimeoutMs": 5000,
    "SyncTimeoutMs": 3000,
    "AbortOnConnectFail": false
  },
  "Elasticsearch": {
    "Uri": "http://localhost:9200",
    "Username": "elastic",
    "Password": "changeme",
    "ProductsIndexName": "products",
    "NumberOfShards": 1,
    "NumberOfReplicas": 1
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "Port": 5672,
    "RetryCount": 3,
    "RetryIntervalSeconds": 5
  },
  "BlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "ContainerName": "product-images",
    "CdnBaseUrl": "",
    "MaxFileSizeBytes": 5242880
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MongoDB.Driver": "Warning",
      "Elastic.Clients": "Warning",
      "MassTransit": "Information"
    }
  },

  "Security": {
    "AzureAd": {
      "TenantId": "a26c39b8-51cd-49fd-a159-8cf9b18802a2",
