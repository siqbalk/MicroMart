<!-- This file proves Domain has ZERO external dependencies -->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>MicroMart.ProductCatalog.Domain</RootNamespace>
        <AssemblyName>MicroMart.ProductCatalog.Domain</AssemblyName>

        <!-- Treat warnings as errors — keeps domain clean -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <Nullable>enable</Nullable>
        <WarningsAsErrors />
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\src\Shared\MicroMart.Shared.Core\MicroMart.Shared.Core.csproj" />
    </ItemGroup>

    <!-- ✅ NO PackageReference entries here
       Domain depends on NOTHING outside .NET BCL
       If you feel like adding a NuGet package here,
       question whether that code belongs in Application
       or Infrastructure instead -->

</Project>